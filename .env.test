# optional for fcm by service account credentials
GOOGLE_APPLICATION_CREDENTIALS=
NOTION_CLIENT_ID=dummy-for-test
NOTION_CLIENT_SECRET=dummy-for-test
# Pinned off: the suite drives the mock explicitly where it needs it, and a test
# run must never reach either the real Notion API or the local mock server.
# The port is pinned for the opposite reason — the cases that do turn the mock on
# assert a literal URL, so it has to be the default here whatever a developer has
# exported to move their own mock server (boot.rb uses Dotenv.overload, so this
# file wins over the shell).
NOTION_MOCK=0
NOTION_MOCK_PORT=4568
NOTION_API_ENDPOINT=
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_APP_ID=
FIREBASE_SERVICE_ACCOUNT=
FCM_SERVER_KEY=
FCM_SENDER_ID=
FCM_VAPID_KEY=
AWS_REGION=ap-northeast-2
AWS_S3_ACCESS_KEY_ID=
AWS_S3_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=collavre-uploads-test
AWS_SES_SMTP_USERNAME=
AWS_SES_SMTP_PASSWORD=
DEFAULT_MAILER_FROM=no-reply@example.com
DEFAULT_URL_HOST=example.com
ORIGIN_SHARED_SECRET=
LINEAR_CLIENT_ID=dummy-for-test
LINEAR_CLIENT_SECRET=dummy-for-test
LINEAR_OAUTH_REDIRECT_URI=https://example.com/linear/auth/callback
