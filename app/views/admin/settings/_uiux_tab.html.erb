<section class="tab-panel active">
  <%= tag.div(flash[:alert], class: "flash-alert") if flash[:alert] %>
  <%= form_with url: admin_settings_path, method: :patch, local: true, html: { class: 'profile-form' } do |f| %>
    <%# uiux tab %>

    <div>
      <h3 style="font-size: 1.1em; margin-bottom: 1em;"><%= t('admin.settings.default_theme') %></h3>
      <div style="display: flex; flex-direction: column; gap: 0.8em;">
        <label class="checkbox-label" style="display: flex; align-items: center; gap: 0.5em;">
          <%= radio_button_tag :default_theme, '', @default_theme.blank?, id: 'default_theme_auto' %>
          <span><%= t('admin.settings.theme_auto') %></span>
        </label>
        <label class="checkbox-label" style="display: flex; align-items: center; gap: 0.5em;">
          <%= radio_button_tag :default_theme, 'light', @default_theme == 'light', id: 'default_theme_light' %>
          <span><%= t('admin.settings.theme_light') %></span>
        </label>
        <label class="checkbox-label" style="display: flex; align-items: center; gap: 0.5em;">
          <%= radio_button_tag :default_theme, 'dark', @default_theme == 'dark', id: 'default_theme_dark' %>
          <span><%= t('admin.settings.theme_dark') %></span>
        </label>
      </div>
      <div class="help-text" style="font-size: 0.85em; color: var(--color-text-muted); margin-top: 0.5em;">
        <%= t('admin.settings.default_theme_hint') %>
      </div>
    </div>

    <%= f.submit t('admin.settings.save') %>
  <% end %>
</section>
