<% content_for :head do %>
  <%= stylesheet_link_tag 'collavre/comments_popup', media: 'all' %>
<% end %>

<h1 class="no-top-margin"><%= t('admin.title') %></h1>

<%= render "admin/shared/tabs" %>

<div class="settings-tabs" style="margin-bottom: 1.5em;">
  <%= link_to t('admin.settings.tabs.system'), admin_path(tab: 'system'),
      class: "tab-button #{'active' if @active_settings_tab == 'system'}" %>
  <%= link_to t('admin.settings.tabs.uiux'), admin_path(tab: 'uiux'),
      class: "tab-button #{'active' if @active_settings_tab == 'uiux'}" %>
</div>

<div class="tab-panels">
  <% if @active_settings_tab == 'system' %>
    <%= render "admin/settings/system_tab" %>
  <% elsif @active_settings_tab == 'uiux' %>
    <%= render "admin/settings/uiux_tab" %>
  <% end %>
</div>
