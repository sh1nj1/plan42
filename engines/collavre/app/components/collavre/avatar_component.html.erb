<div class="avatar-wrapper" style="width: <%= size %>px; height: <%= size %>px;">
  <% unless default_avatar? %>
    <%= image_tag avatar_url,
                alt: '',
                width: size,
                height: size,
                class: classes,
                title: email,
                style: 'border-radius:50%;vertical-align:middle;',
                data: data %>
  <% end %>
  <% if default_avatar? %>
    <%= content_tag :span, class: "avatar-initial #{classes}", title: email, data: data, style: "font-size: #{(size / 2.0).round}px;" do %>
      <%= initial %>
    <% end %>
  <% end %>
</div>
