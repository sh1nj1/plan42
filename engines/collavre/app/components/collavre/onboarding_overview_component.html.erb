<div class="feature-card feature-card--onboarding onboarding-overview" data-controller="onboarding-card">
  <div class="feature-card-icon" aria-hidden="true">🚀</div>
  <div class="feature-card-title"><%= t('collavre.onboarding.overview.title') %></div>
  <p class="feature-card-description"><%= t('collavre.onboarding.overview.description') %></p>
  <strong class="onboarding-overview-progress">
    <%= t('collavre.onboarding.overview.progress', completed: completed_steps, total: TOTAL_STEPS) %>
  </strong>
  <div class="onboarding-overview-actions">
    <%= link_to completion_label,
                onboarding_path,
                class: "feature-card-action",
                data: { turbo_method: :delete, turbo_confirm: completion_confirmation } %>
    <%= link_to t('collavre.onboarding.overview.guide_link'), features_path, class: "feature-card-guide-link" %>
  </div>
</div>
