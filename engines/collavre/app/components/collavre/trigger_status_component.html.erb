<% if @role == :container %>
  <span class="trigger-status trigger-status--container"
        data-controller="trigger-status"
        data-trigger-status-creative-id-value="<%= @creative.id %>"
        data-trigger-status-role-value="container">
    <% if @can_write %>
      <button type="button"
              class="trigger-container-toggle <%= 'trigger-container-active' if container_enabled? %>"
              data-action="click->trigger-status#toggleContainer"
              data-trigger-status-target="toggleBtn"
              title="<%= container_enabled? ? t('collavre.drop_trigger.toggle_on') : t('collavre.drop_trigger.toggle_off') %>">
        <svg width="16" height="16" viewBox="0 0 16 16" fill="none" class="trigger-zap-icon">
          <path d="M8.5 1L3 9h4.5l-1 6L13 7H8.5l1-6z" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round" fill="<%= container_enabled? ? 'currentColor' : 'none' %>"/>
        </svg>
      </button>
    <% elsif container_enabled? %>
      <span class="trigger-container-indicator" title="<%= t('collavre.drop_trigger.toggle_on') %>">
        <svg width="16" height="16" viewBox="0 0 16 16" fill="none" class="trigger-zap-icon">
          <path d="M8.5 1L3 9h4.5l-1 6L13 7H8.5l1-6z" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round" fill="currentColor"/>
        </svg>
      </span>
    <% end %>
  </span>
<% elsif @role == :task %>
  <span class="trigger-status trigger-status--task trigger-status--<%= state %>"
        data-controller="trigger-status"
        data-trigger-status-creative-id-value="<%= @creative.id %>"
        data-trigger-status-role-value="task"
        data-trigger-status-state-value="<%= state %>"
        title="<%= t("collavre.trigger_loop.state_#{state}", default: state.humanize) %> (<%= current_iteration %>/<%= max_iterations %>)">
    <%# Circular progress SVG %>
    <% radius = 7 %>
    <% circumference = 2 * Math::PI * radius %>
    <% dash_offset = circumference * (1 - progress_ratio) %>
    <svg class="trigger-progress-ring" width="20" height="20" viewBox="0 0 20 20">
      <circle class="trigger-progress-ring__bg"
              cx="10" cy="10" r="<%= radius %>"
              fill="none"
              stroke="var(--border-default, #e0e0e0)"
              stroke-width="2"/>
      <circle class="trigger-progress-ring__fg"
              cx="10" cy="10" r="<%= radius %>"
              fill="none"
              stroke="<%= color_token %>"
              stroke-width="2"
              stroke-dasharray="<%= circumference %>"
              stroke-dashoffset="<%= dash_offset %>"
              stroke-linecap="round"
              transform="rotate(-90 10 10)"/>
    </svg>
    <% if @can_write %>
      <% case state %>
      <% when "running", "pending_verification" %>
        <button type="button" class="trigger-action-btn"
                data-action="click->trigger-status#pause"
                data-trigger-status-target="actionBtn"
                title="<%= t('collavre.trigger_loop.pause', default: 'Pause') %>">
          <svg width="10" height="10" viewBox="0 0 10 10"><rect x="1" y="1" width="3" height="8" fill="currentColor"/><rect x="6" y="1" width="3" height="8" fill="currentColor"/></svg>
        </button>
      <% when "paused", "idle", "stuck" %>
        <button type="button" class="trigger-action-btn"
                data-action="click->trigger-status#resume"
                data-trigger-status-target="actionBtn"
                title="<%= t('collavre.trigger_loop.resume', default: 'Resume') %>">
          <svg width="10" height="10" viewBox="0 0 10 10"><polygon points="2,1 9,5 2,9" fill="currentColor"/></svg>
        </button>
      <% when "completed", "max_reached" %>
        <button type="button" class="trigger-action-btn"
                data-action="click->trigger-status#restart"
                data-trigger-status-target="actionBtn"
                title="<%= t('collavre.trigger_loop.restart', default: 'Restart') %>">
          <svg width="10" height="10" viewBox="0 0 10 10"><path d="M8 5a3 3 0 11-1-2.2" stroke="currentColor" stroke-width="1.2" fill="none"/><polygon points="6,1 8,3 6,3.5" fill="currentColor"/></svg>
        </button>
      <% end %>
    <% end %>
  </span>
<% end %>
