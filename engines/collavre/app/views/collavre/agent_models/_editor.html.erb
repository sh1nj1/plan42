<%= form_with scope: :user, url: collavre.user_agent_model_path(@agent), method: :patch,
              data: { action: "submit->comment-agent-model#save", turbo: false, error: t("collavre.comments.agent_model.error") } do |form| %>
  <%= render layout: "collavre/users/model_picker",
             locals: { form: form, models: Collavre::LlmModel.where(llm_vendor: @agent.llm_vendor).suggestions,
                       selected_model: @agent.llm_model } do %>
    <input type="hidden" value="<%= @agent.llm_vendor %>" data-llm-model-target="vendor">
  <% end %>
  <p><%= t("collavre.comments.agent_model.help") %></p>
  <%= form.submit t("collavre.comments.agent_model.save") %>
  <p role="status"><%= @saved ? t("collavre.comments.agent_model.saved") : @agent.errors.full_messages.to_sentence %></p>
<% end %>
