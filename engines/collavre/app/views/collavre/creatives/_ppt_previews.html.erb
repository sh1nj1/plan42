<% if creative.has_permission?(Current.user, :read) %>
  <% creative.files.each do |attachment| %>
    <% next unless attachment.filename.extension.downcase == "pptx" %>
    <iframe class="ppt-attachment-preview" src="<%= creative_ppt_preview_path(creative, attachment) %>" title="<%= t('collavre.ppt_viewer.title', filename: attachment.filename) %>" loading="lazy" allow="fullscreen" allowfullscreen></iframe>
  <% end %>
<% end %>
