<% title = @creative.public_title %>
<% content_for :page_title, title.presence || t('collavre.public_creatives.show.untitled') %>

<div class="landing">
  <article class="landing-section">
    <div class="landing-container public-creative-container">
      <header class="public-creative-header">
        <h1 class="public-creative-title"><%= title.presence || t('collavre.public_creatives.show.untitled') %></h1>
        <% if authenticated? %>
          <%= link_to t('collavre.public_creatives.show.open_in_app'), collavre.creatives_path(id: @creative.id), class: "landing-btn landing-btn-ghost" %>
        <% end %>
      </header>

      <% unless public_creative_heading?(@creative) || title.blank? %>
        <div class="public-creative-body"><%= embed_youtube_iframe(@creative.description) %></div>
      <% end %>

      <%= render partial: "collavre/public_creatives/node", collection: @nodes, as: :node, locals: { level: 1 } %>

      <% if @truncated %>
        <p class="public-creative-truncated"><%= t('collavre.public_creatives.show.truncated') %></p>
      <% end %>

      <% unless authenticated? %>
        <aside class="public-creative-cta">
          <p><%= t('collavre.public_creatives.show.cta', app_name: t('app.name')) %></p>
          <%= link_to t('collavre.users.new.sign_up'), collavre.new_user_path, class: "landing-btn" %>
          <%= link_to t('app.sign_in'), collavre.new_session_path, class: "landing-btn landing-btn-ghost" %>
        </aside>
      <% end %>
    </div>
  </article>

  <footer class="landing-footer">
    <div class="landing-container landing-footer-inner">
      <p class="landing-footer-copy"><%= t('collavre.landing.footer.copyright', year: Date.today.year, app_name: t('app.name')) %></p>
    </div>
  </footer>
</div>
