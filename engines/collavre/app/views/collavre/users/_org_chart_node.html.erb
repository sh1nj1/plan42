<% shares = org_chart_shares.fetch(creative.id, []) %>
<% children = org_chart_children.fetch(creative.id, []) %>
<% has_content = shares.any? || children.any? %>

<details class="org-chart-group" <%= 'open' if depth == 0 %>>
  <summary class="org-chart-creative-row org-chart-depth-<%= depth %>">
    <span class="org-chart-creative-icon"><%= depth == 0 ? '📂' : '📁' %></span>
    <%= link_to strip_tags(creative.description.to_s).truncate(60),
        collavre.creative_path(creative),
        class: "org-chart-creative-link" %>
    <% if creative.user_id == Current.user.id %>
      <span class="org-chart-owner-badge"><%= t('collavre.contacts.org_chart.owner') %></span>
    <% end %>
    <% if has_content %>
      <span class="org-chart-count"><%= shares.size %><%= " + #{children.size}" if children.any? %></span>
    <% end %>
  </summary>

  <div class="org-chart-content">
    <% if shares.any? %>
      <div class="org-chart-members org-chart-indent-<%= depth %>">
        <% shares.sort_by { |s| Collavre::CreativeShare.permissions[s.permission] }.reverse.each do |share| %>
          <% next unless share.user %>
          <div class="org-chart-member-row">
            <div class="org-chart-member-info">
              <%= render Collavre::AvatarComponent.new(
                user: share.user,
                size: 24,
                classes: "avatar org-chart-avatar"
              ) %>
              <span class="org-chart-member-name"><%= share.user.display_name %></span>
            </div>
            <div class="org-chart-member-meta">
              <span class="org-chart-permission-badge org-chart-permission-<%= share.permission %>">
                <%= t("collavre.contacts.org_chart.permissions.#{share.permission}") %>
              </span>
              <% if share.shared_by_id == Current.user.id %>
                <span class="org-chart-direction org-chart-direction-outgoing">
                  <%= t('collavre.contacts.org_chart.shared_by_me') %>
                </span>
              <% elsif share.shared_by_id.present? %>
                <span class="org-chart-direction org-chart-direction-incoming">
                  <%= t('collavre.contacts.org_chart.shared_with_me') %>
                </span>
              <% end %>
            </div>
          </div>
        <% end %>
      </div>
    <% end %>

    <% if children.any? %>
      <div class="org-chart-children org-chart-indent-<%= depth %>">
        <% children.each do |child| %>
          <%= render partial: 'collavre/users/org_chart_node', locals: {
            creative: child,
            org_chart_shares: org_chart_shares,
            org_chart_children: org_chart_children,
            depth: depth + 1
          } %>
        <% end %>
      </div>
    <% end %>

    <% unless has_content %>
      <p class="org-chart-no-members org-chart-indent-<%= depth %>"><%= t('collavre.contacts.org_chart.no_members') %></p>
    <% end %>
  </div>
</details>
