<%= render layout: "collavre/users/model_picker",
           locals: { form: form, models: @llm_models, selected_model: selected_model } do %>
  <div class="form-group">
    <%= form.label :llm_vendor, t('collavre.users.new_ai.vendor_label') %>
    <%= form.select :llm_vendor,
                    options_for_select(Collavre::User::LLM_VENDOR_OPTIONS, selected_vendor),
                    {},
                    class: "stacked-form-control",
                    data: {
                      agent_vendor_target: "vendor",
                      llm_model_target: "vendor",
                      action: "change->llm-model#vendorChanged agent-vendor#update"
                    } %>
    <small class="form-text text-muted"><%= t('collavre.users.new_ai.vendor_help') %></small>
  </div>

  <div class="form-group" data-agent-vendor-target="gateway">
    <%= form.label :agent_gateway_id, t("collavre.users.new_ai.agent_gateway_label") %>
    <%= form.select :agent_gateway_id,
                    options_from_collection_for_select(@agent_gateways, :id, :name, selected_gateway_id),
                    { include_blank: t("collavre.users.new_ai.agent_gateway_blank") },
                    class: "stacked-form-control",
                    data: { agent_vendor_target: "gatewaySelect" } %>
    <small class="form-text text-muted">
      <%= t("collavre.users.new_ai.agent_gateway_help") %>
      <%= link_to t("collavre.users.new_ai.manage_gateways"), collavre.agent_gateways_path,
                  data: { turbo: false } %>
    </small>
    <% if selected_gateway %>
      <div class="alert alert-info mt-2">
        <%= t("collavre.users.edit_ai.gateway_mode", mode: t("collavre.agent_gateways.workspace_mode.#{selected_gateway.workspace_mode}")) %>
      </div>
    <% end %>
  </div>

<% end %>

  <% run_source = local_assigns[:agent_source] %>
  <div class="form-group" data-agent-vendor-target="runOptions">
    <%= form.label :reasoning_effort, t("collavre.users.new_ai.reasoning_effort_label") %>
    <%= form.select :reasoning_effort,
                    options_for_select(Collavre::CliProxy::RunOptions::ALL_EFFORTS, run_source&.reasoning_effort),
                    { include_blank: t("collavre.users.new_ai.reasoning_effort_blank") },
                    class: "stacked-form-control",
                    data: {
                      agent_vendor_target: "effort",
                      efforts: Collavre::CliProxy::RunOptions::EFFORTS.to_json
                    } %>
    <small class="form-text text-muted"><%= t("collavre.users.new_ai.reasoning_effort_help") %></small>
  </div>

  <div class="form-group" data-agent-vendor-target="fastMode">
    <label>
      <%= form.check_box :codex_fast_mode,
                         { checked: run_source&.codex_fast_mode? || false,
                           data: { agent_vendor_target: "fastModeCheckbox" } },
                         "1", "0" %>
      <%= t("collavre.users.new_ai.codex_fast_mode_label") %>
    </label>
    <small class="form-text text-muted"><%= t("collavre.users.new_ai.codex_fast_mode_help") %></small>
  </div>
