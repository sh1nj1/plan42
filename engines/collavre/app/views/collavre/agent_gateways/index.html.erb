<% content_for :head do %>
  <%= stylesheet_link_tag "collavre/agent_gateways", "data-turbo-track": "reload" %>
<% end %>

<div class="gateway-settings">
  <header class="gateway-settings__header">
    <div>
      <h1 class="no-top-margin"><%= t("collavre.agent_gateways.title") %></h1>
      <p class="text-muted"><%= t("collavre.agent_gateways.description") %></p>
    </div>
    <%= link_to t("collavre.agent_gateways.add"), collavre.new_agent_gateway_path, class: "btn btn-primary" %>
  </header>

  <div class="gateway-list" data-controller="gateway-check"
       data-gateway-check-checking-value="<%= t('collavre.agent_gateways.checking') %>"
       data-gateway-check-success-value="<%= t('collavre.agent_gateways.connected') %>"
       data-gateway-check-failed-value="<%= t('collavre.agent_gateways.connection_failed') %>">
    <% @agent_gateways.each do |gateway| %>
      <article class="gateway-card" aria-labelledby="gateway-<%= gateway.id %>-name">
        <div class="gateway-card__heading">
          <h2 id="gateway-<%= gateway.id %>-name"><%= gateway.name %></h2>
          <% unless gateway.active? %><span class="gateway-badge"><%= t("collavre.agent_gateways.inactive") %></span><% end %>
        </div>
        <code class="gateway-card__url"><%= gateway.base_url %></code>
        <dl class="gateway-card__details">
          <div>
            <dt><%= t("collavre.agent_gateways.workspace_mode.label") %></dt>
            <dd><%= t("collavre.agent_gateways.workspace_mode.#{gateway.workspace_mode}") %></dd>
          </div>
          <div>
            <dt><%= t("collavre.agent_gateways.agents") %></dt>
            <dd><%= gateway.agents.count %></dd>
          </div>
        </dl>
        <div class="gateway-actions">
          <button type="button" class="btn btn-sm btn-secondary"
                  data-action="gateway-check#check"
                  data-gateway-check-url-param="<%= collavre.check_agent_gateway_path(gateway) %>">
            <%= t("collavre.agent_gateways.check") %>
          </button>
          <%= link_to t("collavre.agent_gateways.edit"), collavre.edit_agent_gateway_path(gateway), class: "btn btn-sm btn-secondary" %>
          <%= button_to t("collavre.agent_gateways.delete"), collavre.agent_gateway_path(gateway), method: :delete,
                        class: "btn btn-sm btn-danger",
                        form: { data: { turbo_confirm: t("collavre.agent_gateways.confirm_delete") } } %>
          <span data-gateway-check-target="result" class="gateway-check-result text-muted" role="status" aria-live="polite"></span>
        </div>
      </article>
    <% end %>
    <% if @agent_gateways.empty? %>
      <p class="gateway-card text-muted"><%= t("collavre.agent_gateways.empty") %></p>
    <% end %>
  </div>

  <p><%= link_to t("app.back_to_profile"), collavre.user_path(Current.user), class: "btn btn-secondary" %></p>
</div>
