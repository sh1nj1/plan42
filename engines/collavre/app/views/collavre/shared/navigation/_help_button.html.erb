<% default_help_url = collavre.features_path(locale: I18n.locale, script_name: request.script_name) %>
<% help_url = SystemSetting.help_menu_link.presence || default_help_url %>
<%# The built-in guide navigates in the current window: it is one of our own
    pages, so the browser's back button — plus the guide's own return link — is
    the way back, and a new tab left users with no way to return at all.
    An admin-configured URL on another origin keeps its own tab: we cannot add a
    way back to a page we do not control, so replacing the app with it would
    strand the user. A different port or scheme on our own host is another
    origin too — a separate service that carries none of our navigation. %>
<% help_is_external = external_link?(help_url) %>
<%= link_to t('app.help'), help_url,
      id: "creative-guide-link",
      class: "creative-guide-link",
      target: (help_is_external ? "_blank" : nil),
      rel: (help_is_external ? "noopener" : nil) %>
