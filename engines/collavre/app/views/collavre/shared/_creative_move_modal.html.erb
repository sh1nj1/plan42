<div data-controller="creative-move"
     data-creative-move-messages-value="<%= {
       empty: t('collavre.dnd.no_sources'),
       archived: t('collavre.dnd.archived_selection'),
       invalid: t('collavre.dnd.invalid_target'),
       moving: t('collavre.dnd.moving'), complete: t('collavre.dnd.dropped'),
       partial: t('collavre.dnd.partial'), failed: t('collavre.dnd.failed'),
       cancelled: t('collavre.dnd.cancelled')
     }.to_json %>">
  <dialog class="modal-dialog modal-dialog-compact creative-move-dialog" data-creative-move-target="dialog" aria-labelledby="creative-move-title"
          data-action="cancel->creative-move#cancel">
    <h2 id="creative-move-title" class="modal-dialog-header modal-dialog-title"><%= t('collavre.dnd.move_title') %></h2>
    <form data-action="submit->creative-move#submit">
      <div class="modal-dialog-body modal-dialog-fields">
        <div class="modal-dialog-field">
          <label id="creative-move-destination-label" class="modal-dialog-label" for="creative-move-destination"><%= t('collavre.dnd.destination') %></label>
          <input type="text" id="creative-move-destination" class="modal-dialog-input" readonly
                 data-creative-move-target="destination" aria-haspopup="dialog"
                 placeholder="<%= t('collavre.creatives.index.search_placeholder') %>"
                 data-action="click->creative-move#chooseDestination keydown.enter->creative-move#chooseDestination:prevent keydown.space->creative-move#chooseDestination:prevent">
        </div>
        <div class="modal-dialog-field">
          <label class="modal-dialog-label" for="creative-move-direction"><%= t('collavre.dnd.position') %></label>
          <select id="creative-move-direction" class="modal-dialog-input" data-creative-move-target="direction">
            <% %w[child up down].each do |direction| %>
              <option value="<%= direction %>"><%= t("collavre.dnd.#{direction}") %></option>
            <% end %>
          </select>
        </div>
        <div class="modal-dialog-field">
          <label class="modal-dialog-label" for="creative-move-mode"><%= t('collavre.dnd.operation') %></label>
          <select id="creative-move-mode" class="modal-dialog-input" data-creative-move-target="mode">
            <% %w[move link].each do |mode| %>
              <option value="<%= mode %>"><%= t("collavre.dnd.#{mode}") %></option>
            <% end %>
          </select>
        </div>
        <p class="creative-move-status" role="status" aria-live="polite" data-creative-move-target="status"></p>
      </div>
      <div class="modal-dialog-footer">
        <button type="button" class="modal-dialog-btn modal-dialog-btn-secondary" data-action="creative-move#cancel"><%= t('collavre.dnd.cancel') %></button>
        <button type="submit" class="modal-dialog-btn modal-dialog-btn-primary" data-creative-move-target="confirm" disabled><%= t('collavre.dnd.confirm') %></button>
      </div>
    </form>
    <div class="modal-dialog-footer">
      <p class="modal-dialog-hints desktop-only"><%= t('collavre.dnd.drag_drop_hint') %></p>
      <p class="modal-dialog-hints mobile-only"><%= t('collavre.dnd.mobile_drag_drop_hint') %></p>
    </div>
  </dialog>
  <span role="status" aria-live="polite" class="creative-move-announcement" data-creative-move-target="announcement"></span>
</div>
