<!DOCTYPE html>
<html>
  <head>
    <%# The feature guide pages share this layout but need their own title and
        description for search results and shared links, so both fall back to the
        landing copy rather than being hardcoded to it. %>
    <% page_title = content_for(:page_title).presence || t('collavre.landing.meta.title') %>
    <% page_description = content_for(:page_description).presence || t('collavre.landing.meta.description') %>
    <title><%= t('app.name') %> — <%= page_title %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="description" content="<%= page_description %>">
    <meta property="og:title" content="<%= t('app.name') %> — <%= page_title %>">
    <meta property="og:description" content="<%= page_description %>">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <link rel="icon" href="/icon-1e3cf549d2.png" type="image/png">
    <link rel="icon" href="/icon-1e3cf549d2.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon-1e3cf549d2.png">

    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= collavre_stylesheets %>
    <%= stylesheet_link_tag "collavre/landing", "data-turbo-track": "reload" %>

    <%= javascript_include_tag "application", "data-turbo-track": "reload", defer: true, type: "module" %>

    <%# Admin-configured default themes for users without personal theme %>
    <% default_styles = default_theme_styles %>
    <% if default_styles.present? %>
      <style id="default-theme-styles" data-turbo-track="reload"><%= default_styles %></style>
    <% end %>
  </head>
  <body class="<%= body_theme_class %> landing-page">
    <%# This layout carries no application navigation, so every page under it —
        the marketing landing page and the feature guide alike — leaves a
        signed-in reader with nothing that leads back into the app. The help
        menu now navigates in place, and the desktop shell's single webview has
        no back button, so that return has to be on the page. It belongs here
        rather than in each view: the gap is the layout's, and a page added
        under it later would otherwise have to remember to close it again. %>
    <% if authenticated? %>
      <div class="landing-return-bar">
        <%= link_to t('collavre.landing.nav.back_to_app', app_name: t('app.name')),
              main_app.root_path,
              class: "landing-return-link" %>
      </div>
    <% end %>
    <main>
      <%= yield %>
    </main>
  </body>
</html>
