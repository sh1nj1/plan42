<%# Partial to be included in user edit page for AI agents with llm_vendor == "openclaw" %>
<div class="form-group mt-4 p-4 border border-indigo-200 rounded-lg bg-indigo-50">
  <h3 class="text-lg font-medium text-gray-900 flex items-center mb-4">
    <svg class="w-5 h-5 mr-2 text-indigo-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/>
    </svg>
    <%= t("collavre_openclaw.integration.label") %> Configuration
  </h3>

  <% if user.openclaw_account %>
    <div class="space-y-3">
      <div class="flex items-center justify-between">
        <div>
          <p class="text-sm font-medium text-gray-700">Gateway URL</p>
          <p class="text-sm text-gray-600"><%= user.openclaw_account.gateway_url %></p>
        </div>
        <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-green-100 text-green-800">
          <span class="w-2 h-2 bg-green-500 rounded-full mr-1"></span>
          <%= t("collavre_openclaw.status.connected") %>
        </span>
      </div>

      <% if user.openclaw_account.channel_id.present? %>
        <div>
          <p class="text-sm font-medium text-gray-700">Channel</p>
          <p class="text-sm text-gray-600"><%= user.openclaw_account.channel_id %></p>
        </div>
      <% end %>

      <div class="pt-2">
        <%= link_to openclaw_engine.edit_account_path(user.openclaw_account, user_id: user.id),
                    class: "text-indigo-600 hover:text-indigo-800 text-sm font-medium" do %>
          Edit Connection Settings →
        <% end %>
      </div>
    </div>
  <% else %>
    <p class="text-sm text-gray-600 mb-4">
      <%= t("collavre_openclaw.integration.description") %>
    </p>
    <p class="text-sm text-amber-700 bg-amber-50 p-3 rounded mb-4">
      ⚠️ You need to configure the OpenClaw gateway connection for this agent to work.
    </p>
    <%= link_to openclaw_engine.new_account_path(user_id: user.id),
                class: "inline-flex items-center px-4 py-2 border border-transparent text-sm font-medium rounded-md text-white bg-indigo-600 hover:bg-indigo-700" do %>
      <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6"/>
      </svg>
      Configure OpenClaw Gateway
    <% end %>
  <% end %>
</div>
