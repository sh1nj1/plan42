<%# Partial to be included in user edit page for AI agents with llm_vendor == "openclaw" %>
<div class="form-group mt-4 p-4 border border-indigo-200 rounded-lg bg-indigo-50">
  <h3 class="text-lg font-medium text-gray-900 flex items-center mb-4">
    <svg class="w-5 h-5 mr-2 text-indigo-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/>
    </svg>
    <%= t("collavre_openclaw.integration.label") %> Configuration
  </h3>

  <% if user.gateway_url.present? %>
    <div class="space-y-3">
      <div class="flex items-center justify-between">
        <div>
          <p class="text-sm font-medium text-gray-700">Gateway URL</p>
          <p class="text-sm text-gray-600"><%= user.gateway_url %></p>
        </div>
        <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-green-100 text-green-800">
          <span class="w-2 h-2 bg-green-500 rounded-full mr-1"></span>
          <%= t("collavre_openclaw.status.connected") %>
        </span>
      </div>

      <p class="text-sm text-gray-500">
        Agent ID: <code class="bg-gray-100 px-1 rounded"><%= user.email.split("@").first %></code>
        <span class="text-gray-400">(derived from email)</span>
      </p>
    </div>
  <% else %>
    <p class="text-sm text-gray-600 mb-4">
      <%= t("collavre_openclaw.integration.description") %>
    </p>
    <div class="text-sm text-amber-700 bg-amber-50 p-3 rounded mb-4">
      <p class="font-medium mb-2">⚠️ Gateway URL Required</p>
      <p>Set the <strong>Gateway URL</strong> field above to connect this agent to OpenClaw.</p>
      <p class="mt-2 text-gray-600">
        Example: <code class="bg-white px-1 rounded">http://localhost:18789</code>
      </p>
    </div>
  <% end %>
</div>
