<%= form_with model: account, url: account.persisted? ? account_path(account) : accounts_path, class: "profile-form" do |f| %>
  <%= f.hidden_field :user_id, value: @ai_user.id %>

  <% if account.errors.any? %>
    <div class="flash-alert">
      <strong><%= pluralize(account.errors.count, "error") %> prevented this account from being saved:</strong>
      <ul>
        <% account.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= f.label :gateway_url, t("collavre_openclaw.form.gateway_url") %>
    <%= f.url_field :gateway_url, required: true, placeholder: "https://your-openclaw-gateway.com" %>
    <small><%= t("collavre_openclaw.form.gateway_url_hint") %></small>
  </div>

  <div>
    <%= f.label :api_token, t("collavre_openclaw.form.api_token") %>
    <% if account.persisted? && account.token_configured? %>
      <div class="token-status token-status--configured">
        <span class="token-status__indicator">✓</span>
        <span class="token-status__text"><%= t("collavre_openclaw.form.token_configured") %></span>
        <%= link_to t("collavre_openclaw.form.clear_token"),
                    clear_token_account_path(account),
                    class: "token-status__clear-btn",
                    data: { turbo_method: :delete, turbo_confirm: t("collavre_openclaw.form.clear_token_confirm") } %>
      </div>
      <%= f.password_field :api_token, placeholder: t("collavre_openclaw.form.token_placeholder_update") %>
      <small><%= t("collavre_openclaw.form.api_token_hint_update") %></small>
    <% elsif account.persisted? %>
      <div class="token-status token-status--not-configured">
        <span class="token-status__indicator">○</span>
        <span class="token-status__text"><%= t("collavre_openclaw.form.token_not_configured") %></span>
      </div>
      <%= f.password_field :api_token, placeholder: "" %>
      <small><%= t("collavre_openclaw.form.api_token_hint") %></small>
    <% else %>
      <%= f.password_field :api_token, placeholder: "" %>
      <small><%= t("collavre_openclaw.form.api_token_hint") %></small>
    <% end %>
  </div>

  <div>
    <%= f.label :channel_id, t("collavre_openclaw.form.channel_id") %>
    <%= f.text_field :channel_id %>
    <small><%= t("collavre_openclaw.form.channel_id_hint") %></small>
  </div>

  <%= f.submit account.persisted? ? t("collavre_openclaw.form.submit_update") : t("collavre_openclaw.form.submit_create") %>
  <%= link_to t("collavre_openclaw.form.cancel"), collavre.edit_ai_user_path(@ai_user), class: "btn-link" %>
<% end %>
