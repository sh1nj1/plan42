<% unless !CollavreTranslation.enabled? || local_assigns[:streaming] || comment.content.blank? %>
  <%# Reader-neutral gate: public content follows its author, the rest is left to the reader page. %>
  <% public_content = CollavreTranslation::ContentTranslationPolicy.public_content?(comment) %>
  <% if !public_content || CollavreTranslation.enabled_for?(comment.user) %>
  <template data-comment-translation-template<%= " data-comment-translation-reader-gated" unless public_content %>>
    <div data-comment-translation-url-value="<%= collavre_translation.comment_translation_path(comment_id: comment.id) %>"
       data-comment-translation-digest-value="<%= CollavreTranslation::Translation.digest(comment.content) %>"
       data-comment-translation-translate-value="<%= t('collavre_translation.translate') %>"
       data-comment-translation-loading-value="<%= t('collavre_translation.loading') %>"
       data-comment-translation-original-value="<%= t('collavre_translation.original') %>"
       data-comment-translation-show-translation-value="<%= t('collavre_translation.show_translation') %>">
      <div data-comment-translation-target="content" hidden></div>
      <div class="comment-content-action-controls" aria-live="polite" aria-atomic="true">
        <button type="button" data-comment-translation-target="toggle" data-action="comment-translation#toggle"
                hidden></button>
      </div>
    </div>
  </template>
  <% end %>
<% end %>
