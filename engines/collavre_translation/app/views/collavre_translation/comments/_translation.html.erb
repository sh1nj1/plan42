<% unless !CollavreTranslation.enabled? || local_assigns[:streaming] || comment.content.blank? %>
  <template data-comment-translation-template>
    <div data-comment-translation-url-value="<%= collavre_translation.comment_translation_path(comment_id: comment.id) %>"
       data-comment-translation-digest-value="<%= CollavreTranslation::Translation.digest(comment.content) %>"
       data-comment-translation-loading-value="<%= t('collavre_translation.loading') %>"
       data-comment-translation-translated-value="<%= t('collavre_translation.translated') %>"
       data-comment-translation-original-value="<%= t('collavre_translation.original') %>"
       data-comment-translation-show-translation-value="<%= t('collavre_translation.show_translation') %>">
      <div data-comment-translation-target="content" hidden></div>
      <button type="button" data-comment-translation-target="toggle" data-action="comment-translation#toggle" hidden></button>
    </div>
  </template>
<% end %>
