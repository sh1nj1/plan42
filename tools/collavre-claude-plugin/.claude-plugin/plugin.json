{
  "name": "collavre",
  "version": "0.1.0",
  "description": "Connects Claude Code sessions to Collavre inbox for real-time communication via channels",
  "author": {
    "name": "VReRV"
  },
  "repository": "https://github.com/AIdoodle/plan42",
  "license": "MIT",
  "userConfig": {
    "url": {
      "description": "Collavre server URL (e.g., https://collavre.example.com)",
      "sensitive": false
    },
    "token": {
      "description": "Collavre API authentication token",
      "sensitive": true
    }
  },
  "channels": [
    {
      "server": "collavre"
    }
  ],
  "mcpServers": {
    "collavre": {
      "command": "node",
      "args": ["${CLAUDE_PLUGIN_ROOT}/dist/index.js"],
      "env": {
        "CLAUDE_PLUGIN_OPTION_url": "${user_config.url}",
        "CLAUDE_PLUGIN_OPTION_token": "${user_config.token}"
      }
    }
  },
  "hooks": "hooks/hooks.json"
}
