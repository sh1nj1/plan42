{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Collavre Desktop",
  "version": "0.1.0",
  "identifier": "net.collavre.desktop",
  "build": {
    "frontendDist": "./dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "icon": [
      "icons/icon.icns"
    ],
    "resources": {
      "../staging/app": "app"
    },
    "macOS": {
      "minimumSystemVersion": "11.0"
    }
  }
}
