COLLAVRE_SERVER=
KAMAL_REGISTRY_USER=
KAMAL_SSH_USER=collavre
KAMAL_SSH_KEY_PATH=~/.ssh/id_rsa

KAMAL_REGISTRY_PASSWORD=
RAILS_MASTER_KEY=
SECRET_KEY_BASE=
# DATABASE_URL=sqlite3:storage/production-primary.sqlite3
# Local development/test on Postgres (SQLite -> Postgres migration). Leave unset
# for the default SQLite. Set DB_ADAPTER=postgresql to use the local collavre_db
# without a DATABASE_URL; the vars below override the built-in local defaults.
# DB_ADAPTER=postgresql
# DATABASE_HOST=localhost
# DATABASE_USERNAME=collavre_user
# DATABASE_PASSWORD=
# DATABASE_NAME=collavre_db
# TEST_DATABASE_NAME=collavre_test
PORT=80
# Run the Solid Queue supervisor inside Puma on this deploy target (default: true).
# Set to false when several targets share one database, so that exactly one of
# them claims background jobs.
# SOLID_QUEUE_IN_PUMA=true
GEMINI_API_KEY=
# empty for default
GEMINI_API_BASE=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# GitHub mock: auto-enabled in development when GITHUB_CLIENT_ID is blank.
# Mock server runs via Procfile.dev (port 4567).
# Set GITHUB_MOCK=0 to force disable, or GITHUB_API_ENDPOINT to override URL.
# GITHUB_MOCK=0
# GITHUB_API_ENDPOINT=http://localhost:4567
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# optional for fcm by service account credentials
GOOGLE_APPLICATION_CREDENTIALS=
NOTION_CLIENT_ID=
NOTION_CLIENT_SECRET=
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_APP_ID=
# Server FCM auth — pick ONE path:
#  (a) paste a service account key JSON body (recommended, any host)
FIREBASE_SERVICE_ACCOUNT_JSON=
#  (b) Workload Identity Federation on AWS — SA email to impersonate.
#      With only FCM_WIF_SERVICE_ACCOUNT_EMAIL + FCM_SENDER_ID set in production,
#      audience and credential source fall back to the AWS defaults.
FCM_WIF_SERVICE_ACCOUNT_EMAIL=
#      Optional WIF overrides for non-default pools/providers:
FCM_WIF_AUDIENCE=
FCM_WIF_CREDENTIAL_SOURCE=
FCM_SERVER_KEY=
FCM_SENDER_ID=
FCM_VAPID_KEY=
AWS_REGION=ap-northeast-2
AWS_S3_ACCESS_KEY_ID=
AWS_S3_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=collavre-uploads-development
AWS_SES_SMTP_USERNAME=
AWS_SES_SMTP_PASSWORD=
DEFAULT_MAILER_FROM=no-reply@example.com
DEFAULT_URL_HOST=collavre.com
ORIGIN_SHARED_SECRET=

# Active Record encryption (required for encrypted columns) - use `rails db:encryption:init` for generation
ACTIVE_RECORD_ENCRYPTION_PRIMARY_KEY=
ACTIVE_RECORD_ENCRYPTION_DETERMINISTIC_KEY=
ACTIVE_RECORD_ENCRYPTION_KEY_DERIVATION_SALT=

# collavre_slack engine
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_SIGNING_SECRET=
SLACK_REDIRECT_URI=

# collavre_linear engine
LINEAR_CLIENT_ID=
LINEAR_CLIENT_SECRET=
LINEAR_OAUTH_REDIRECT_URI=

# CloudFront / CDN host serving /public-assets/* (optional; defaults to app host)
PUBLIC_ASSETS_HOST=
