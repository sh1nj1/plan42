COLLAVRE_SERVER=
KAMAL_REGISTRY_USER=
KAMAL_SSH_USER=collavre
KAMAL_SSH_KEY_PATH=~/.ssh/id_rsa

KAMAL_REGISTRY_PASSWORD=
RAILS_MASTER_KEY=
SECRET_KEY_BASE=
# DATABASE_URL=sqlite3:storage/production-primary.sqlite3
PORT=80
# Run the Solid Queue supervisor inside Puma on this deploy target (default: true).
# Set to false when several targets share one database, so that exactly one of
# them claims background jobs.
# SOLID_QUEUE_IN_PUMA=true

# Threads for the dedicated ai_agents Solid Queue worker (default: 12).
# Sets execution capacity; raise with orchestrator max_concurrent_jobs if needed (code default 5).
# AI_AGENT_THREADS=12

# Override the Active Record connection pool size. Defaults to the formula in
# config/database.yml: RAILS_MAX_THREADS + AI_AGENT_THREADS + 10.
# DB_POOL=30

GEMINI_API_KEY=
# empty for default
GEMINI_API_BASE=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# GitHub mock: auto-enabled in development when GITHUB_CLIENT_ID is blank.
# Mock server runs via Procfile.dev (port 4567).
# Set GITHUB_MOCK=0 to force disable, or GITHUB_API_ENDPOINT to override URL.
# GITHUB_MOCK=0
# GITHUB_API_ENDPOINT=http://localhost:4567
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# optional for fcm by service account credentials
GOOGLE_APPLICATION_CREDENTIALS=
NOTION_CLIENT_ID=
NOTION_CLIENT_SECRET=
# Notion mock: auto-enabled in development when NOTION_CLIENT_ID is blank, and
# forced on/off with NOTION_MOCK=1/0 — the client id may also come from Rails
# credentials or the admin UI, so a blank value here does not by itself mean
# "mocked". Mock server runs via Procfile.dev, on NOTION_MOCK_PORT (default
# 4568) — the server and the auto-mocked client both read that, so moving it off
# a conflicting port needs no second setting.
# All three keys below are development/test only, and none is carried into
# .kamal/secrets or config/deploy.yml — under RAILS_ENV=production the code
# ignores them rather than merely lacking a way to set them. The mock signs
# every browser in as one fixed workspace; NOTION_API_ENDPOINT would let one
# env var send every user's real workspace token to a host of the setter's
# choosing, and Notion has no self-hosted edition to legitimately name.
# (GITHUB_API_ENDPOINT above is not the same case — GitHub Enterprise Server is
# a real production target, so it is a settable integration in the admin UI.)
# NOTION_MOCK and NOTION_MOCK_PORT are read once, at boot: changing them (or
# the client id) in the admin UI takes effect on restart.
# NOTION_MOCK=0
# NOTION_MOCK_PORT=4568
# NOTION_API_ENDPOINT=http://localhost:4568/v1
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_APP_ID=
# Server FCM auth — pick ONE path:
#  (a) paste a service account key JSON body (recommended, any host)
FIREBASE_SERVICE_ACCOUNT_JSON=
#  (b) Workload Identity Federation on AWS — SA email to impersonate.
#      With only FCM_WIF_SERVICE_ACCOUNT_EMAIL + FCM_SENDER_ID set in production,
#      audience and credential source fall back to the AWS defaults.
FCM_WIF_SERVICE_ACCOUNT_EMAIL=
#      Optional WIF overrides for non-default pools/providers:
FCM_WIF_AUDIENCE=
FCM_WIF_CREDENTIAL_SOURCE=
FCM_SERVER_KEY=
FCM_SENDER_ID=
FCM_VAPID_KEY=
AWS_REGION=ap-northeast-2
AWS_S3_ACCESS_KEY_ID=
AWS_S3_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=collavre-uploads-development
AWS_SES_SMTP_USERNAME=
AWS_SES_SMTP_PASSWORD=
DEFAULT_MAILER_FROM=no-reply@example.com
DEFAULT_URL_HOST=collavre.com
ORIGIN_SHARED_SECRET=

# Active Record encryption (required for encrypted columns) - use `rails db:encryption:init` for generation
ACTIVE_RECORD_ENCRYPTION_PRIMARY_KEY=
ACTIVE_RECORD_ENCRYPTION_DETERMINISTIC_KEY=
ACTIVE_RECORD_ENCRYPTION_KEY_DERIVATION_SALT=

# collavre_slack engine
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_SIGNING_SECRET=
SLACK_REDIRECT_URI=

# collavre_linear engine
LINEAR_CLIENT_ID=
LINEAR_CLIENT_SECRET=
LINEAR_OAUTH_REDIRECT_URI=

# CloudFront / CDN host serving /public-assets/* (optional; defaults to app host)
PUBLIC_ASSETS_HOST=
