#!/usr/bin/env ruby
# frozen_string_literal: true

# Entity-level complexity ratchet, over Ruby (RuboCop's Metrics department) and
# the core engine's JavaScript (ESLint's size and complexity rules). See
# lib/complexity_ratchet.rb for why this exists, lib/complexity_ratchet/
# javascript.rb for the JavaScript half, and docs/complexity_budget.md for how
# to work with it.
#
#   bin/complexity_check                  # gate: fail on growth or new debt vs the merge base
#   bin/complexity_check --base <ref>     # compare against something other than origin/main
#   bin/complexity_check --report         # list what is over budget in the working tree
#
# There is no --regenerate and nothing to commit: the comparison is against a
# checkout of the merge base, measured in the same run.

require "rubygems"
require "bundler/setup"
require "optparse"

ROOT = File.expand_path("..", __dir__)
require File.join(ROOT, "lib", "complexity_ratchet")
require File.join(ROOT, "lib", "complexity_ratchet", "base_tree")
require File.join(ROOT, "lib", "complexity_ratchet", "javascript")

options = { mode: :check, base: ENV.fetch("COMPLEXITY_BASE_REF", "origin/main") }
OptionParser.new do |parser|
  parser.banner = "Usage: bin/complexity_check [options]"
  parser.on("--base REF", "Compare against merge-base(HEAD, REF) (default: origin/main)") { |ref| options[:base] = ref }
  parser.on("--report", "Print the working tree's over-budget entities and exit 0") { options[:mode] = :report }
  # CI passes this only when a reviewer has applied `complexity-baseline-reset`,
  # which is how a deliberate budget change gets through.
  parser.on("--allow-budget-change", "Skip the budget comparison") { options[:allow_budget_change] = true }
  parser.on("-h", "--help") do
    puts parser
    exit 0
  end
end.parse!

WAIVERS   = File.join(ROOT, ComplexityRatchet::WAIVERS_PATH)
CONFIG    = File.join(ROOT, ComplexityRatchet::CONFIG_PATH)
JS_CONFIG = File.join(ROOT, ComplexityRatchet::Javascript::CONFIG_PATH)

def abort_with(message)
  warn message
  exit 1
end

def report(problems)
  problems.group_by(&:kind).each do |kind, group|
    puts "\n#{kind.to_s.tr('_', ' ')} (#{group.size})"
    group.sort_by(&:key).each { |problem| puts "  #{problem.key}\n      #{problem.message}" }
  end
end

def file_at(ref, path)
  out, _err, status = Open3.capture3("git", "show", "#{ref}:#{path}", chdir: ROOT)
  status.success? ? out : nil
end

def budget_problems(base_sha, options)
  return [] if options[:allow_budget_change]

  ComplexityRatchet.verify_budget(
    file_at(base_sha, ComplexityRatchet::CONFIG_PATH)&.then { |yaml| YAML.safe_load(yaml) || {} },
    YAML.safe_load_file(CONFIG) || {}
  ) +
    ComplexityRatchet::Javascript.verify_budget(
      file_at(base_sha, ComplexityRatchet::Javascript::CONFIG_PATH)&.then { |yaml| YAML.safe_load(yaml) || {} },
      YAML.safe_load_file(JS_CONFIG) || {}
    )
end

# Ruby and JavaScript entities share one hash, one waiver list and one
# comparison: the key carries the path and the rule, so the two cannot collide,
# and everything downstream of here is language-agnostic.
def measure(root:, env: {})
  ComplexityRatchet::Measurement.call(root: root, env: env)
    .merge(ComplexityRatchet::Javascript::Measurement.call(root: root, tool_root: ROOT))
end

actual = measure(root: ROOT)

if options[:mode] == :report
  puts "#{actual.size} entities over the budgets in #{ComplexityRatchet::CONFIG_PATH} " \
       "and #{ComplexityRatchet::Javascript::CONFIG_PATH}:"
  actual.sort.each { |key, value| puts "  #{value}\t#{key}" }
  exit 0
end

base_measurement = nil
base_sha = nil
ComplexityRatchet::BaseTree.at_merge_base(root: ROOT, ref: options[:base]) do |tree, sha|
  base_sha = sha
  base_measurement = measure(root: tree, env: { "BUNDLE_GEMFILE" => File.join(ROOT, "Gemfile") })
end

if base_measurement.nil?
  puts "HEAD is the merge base with #{options[:base]} — nothing to compare against."
  exit 0
end

problems =
  ComplexityRatchet::Check.new(
    actual: actual,
    base: base_measurement,
    waivers: ComplexityRatchet.load_waivers(WAIVERS)
  ).problems +
  # The budget is the one input the merge-base comparison cannot check itself:
  # both sides are measured with this branch's copy, on purpose, so a raised Max
  # silences the same entities twice and cancels out.
  budget_problems(base_sha, options)

blocking = problems.select(&:blocking?)

if blocking.empty?
  report(problems) unless problems.empty?
  puts "\nComplexity ratchet OK — #{actual.size} entities over budget " \
       "(#{base_measurement.size} at #{base_sha[0, 12]}), none grew."
  exit 0
end

report(problems)
abort_with("\n#{blocking.size} blocking complexity problem(s) against #{base_sha[0, 12]}. " \
           "Shrink the entity, or add a time-boxed waiver to #{ComplexityRatchet::WAIVERS_PATH} " \
           "with an owner, a reason, and an expiry.\n" \
           "A deliberate budget change goes through the `complexity-baseline-reset` label instead.")
