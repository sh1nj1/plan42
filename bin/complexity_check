#!/usr/bin/env ruby
# frozen_string_literal: true

# Entity-level complexity ratchet. See lib/complexity_ratchet.rb for why this
# exists and docs/complexity_budget.md for how to work with it.
#
#   bin/complexity_check                     # gate: fail on growth, new debt, or a stale baseline
#   bin/complexity_check --regenerate        # record shrunk/removed entities after a refactor
#   bin/complexity_check --verify-baseline origin/main
#                                            # fail if the baseline was loosened in this branch
#   bin/complexity_check --seed              # bootstrap the baseline (one time only)

require "rubygems"
require "bundler/setup"
require "optparse"

ROOT = File.expand_path("..", __dir__)
require File.join(ROOT, "lib", "complexity_ratchet")

options = { mode: :check }
OptionParser.new do |parser|
  parser.banner = "Usage: bin/complexity_check [options]"
  parser.on("--regenerate", "Update the baseline for entities that shrank or disappeared") { options[:mode] = :regenerate }
  parser.on("--seed", "Write a fresh baseline from the current codebase (bootstrap only)") { options[:mode] = :seed }
  parser.on("--verify-baseline REF", "Fail if the baseline was loosened relative to REF") do |ref|
    options[:mode] = :verify
    options[:ref] = ref
  end
  parser.on("-h", "--help") do
    puts parser
    exit 0
  end
end.parse!

BASELINE = File.join(ROOT, ComplexityRatchet::BASELINE_PATH)
WAIVERS  = File.join(ROOT, ComplexityRatchet::WAIVERS_PATH)
CONFIG   = File.join(ROOT, ComplexityRatchet::CONFIG_PATH)
LOCK     = File.join(ROOT, ComplexityRatchet::LOCK_PATH)

def abort_with(message)
  warn message
  exit 1
end

def report(problems)
  problems.group_by(&:kind).each do |kind, group|
    puts "\n#{kind.to_s.tr('_', ' ')} (#{group.size})"
    group.sort_by(&:key).each { |problem| puts "  #{problem.key}\n      #{problem.message}" }
  end
end

# --verify-baseline reads the base ref's own copy of a file, so it only ever
# judges what this branch changed. nil means the ref predates that file.
def file_at(ref, path)
  out, _err, status = Open3.capture3("git", "show", "#{ref}:#{path}", chdir: ROOT)
  status.success? ? out : nil
end

# The sibling checks need the population and the anchors of every baselined
# file, on both sides of the comparison. Reading each side once and profiling it
# once is not just tidier: asking for the two views separately ran `git show`
# twice per file and parsed all 129 of them four times over.
def sources_at(ref, paths)
  paths.to_h { |path| [ path, file_at(ref, path) ] }
end

def current_sources(paths)
  paths.to_h do |path|
    full_path = File.join(ROOT, path)
    [ path, File.file?(full_path) ? File.read(full_path) : nil ]
  end
end

case options[:mode]
when :verify
  base_baseline = file_at(options[:ref], ComplexityRatchet::BASELINE_PATH)
  if base_baseline.nil?
    puts "#{options[:ref]} predates #{ComplexityRatchet::BASELINE_PATH} — nothing to verify."
    exit 0
  end

  base_config = file_at(options[:ref], ComplexityRatchet::CONFIG_PATH)
  before_entries = ComplexityRatchet.flatten(YAML.safe_load(base_baseline) || {})
  ComplexityRatchet.validate_baseline_values!(before_entries)
  after_entries = ComplexityRatchet.load_baseline(BASELINE)
  baseline_paths = (before_entries.keys | after_entries.keys).map { |key| key.split(ComplexityRatchet::SEPARATOR, 2).first }

  # Three ways to unwind the ratchet, and only one of them touches the baseline.
  # Raising a Max deletes baseline entries wholesale, which reads as a refactor
  # to verify_monotonic; upgrading RuboCop does the same without editing a file
  # in this repository at all. So the budget and the toolchain that supplies its
  # inherited half are both checked alongside the baseline.
  before_profile = ComplexityRatchet.sibling_profile(sources_at(options[:ref], baseline_paths))
  after_profile = ComplexityRatchet.sibling_profile(current_sources(baseline_paths))

  problems =
    ComplexityRatchet.verify_monotonic(
      before_entries,
      after_entries,
      before_siblings: before_profile.fetch(:populations),
      after_siblings: after_profile.fetch(:populations),
      before_sibling_anchors: before_profile.fetch(:anchors),
      after_sibling_anchors: after_profile.fetch(:anchors)
    ) +
    ComplexityRatchet.verify_budget(
      base_config && (YAML.safe_load(base_config) || {}),
      YAML.safe_load_file(CONFIG) || {}
    ) +
    ComplexityRatchet.verify_toolchain(
      file_at(options[:ref], ComplexityRatchet::LOCK_PATH),
      File.read(LOCK)
    )

  if problems.empty?
    puts "Complexity baseline and budget are unchanged or tightened relative to #{options[:ref]}."
    exit 0
  end

  report(problems)
  abort_with("\nThe complexity baseline and the budget in #{ComplexityRatchet::CONFIG_PATH} may only tighten. " \
             "Fix the entity, or add a time-boxed waiver to #{ComplexityRatchet::WAIVERS_PATH} " \
             "with an owner, a reason, and an expiry.\n" \
             "A deliberate budget or RuboCop change goes through the `complexity-baseline-reset` label instead.")
end

actual = ComplexityRatchet::Measurement.call(root: ROOT)

case options[:mode]
when :seed
  ComplexityRatchet.dump_baseline(BASELINE, actual)
  puts "Seeded #{ComplexityRatchet::BASELINE_PATH} with #{actual.size} entities."
when :regenerate
  baseline = ComplexityRatchet.load_baseline(BASELINE)
  updated, unrecorded = ComplexityRatchet.regenerate(
    baseline, actual, waivers: ComplexityRatchet.load_waivers(WAIVERS)
  )
  ComplexityRatchet.dump_baseline(BASELINE, updated)
  puts "Baseline: #{baseline.size} -> #{updated.size} entities."
  unless unrecorded.empty?
    puts "\nNOT added to the baseline (#{unrecorded.size}) — new debt has to be fixed or waived:"
    unrecorded.sort.each { |key| puts "  #{key}" }
    exit 1
  end
when :check
  check = ComplexityRatchet::Check.new(
    actual: actual,
    baseline: ComplexityRatchet.load_baseline(BASELINE),
    waivers: ComplexityRatchet.load_waivers(WAIVERS)
  )

  if check.pass?
    advisory = check.problems
    report(advisory) unless advisory.empty?
    puts "\nComplexity ratchet OK — #{actual.size} entities over budget, none grew."
    exit 0
  end

  report(check.problems)
  abort_with("\n#{check.blocking_problems.size} blocking complexity problem(s). " \
             "Shrink the entity, run `bin/complexity_check --regenerate` if you improved it, " \
             "or add a time-boxed waiver to #{ComplexityRatchet::WAIVERS_PATH}.")
end
