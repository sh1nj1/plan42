#!/bin/bash

set -o pipefail

echo "🔍 Running pre-push checks..."

# Colors
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

REPO_ROOT=$(git rev-parse --show-toplevel)
cd "$REPO_ROOT" || exit 1

ZERO_SHA="0000000000000000000000000000000000000000"
REMOTE_NAME="${1:-origin}"
PUSH_UPDATES=$(cat)
RANGES=()
RECEIVED_UPDATE=false
EMPTY_TREE_SHA=$(git hash-object -t tree /dev/null) || exit 1

fallback_base_sha() {
    local local_sha="$1"
    shift

    for candidate in "$@"; do
      [ -z "$candidate" ] && continue
      if git rev-parse --verify --quiet "$candidate^{commit}" >/dev/null; then
	git merge-base "$local_sha" "$candidate" && return
      fi
    done

    printf '%s\n' "$EMPTY_TREE_SHA"
}

while read -r _local_ref local_sha remote_ref remote_sha; do
    [ -z "$local_sha" ] && continue
    RECEIVED_UPDATE=true

    # Deleting a remote ref has no source files to check.
    [ "$local_sha" = "$ZERO_SHA" ] && continue

    if [ -n "${PRE_PUSH_BASE_REF:-}" ]; then
      RANGES+=("${PRE_PUSH_BASE_REF}..${local_sha}")
    elif [ "$remote_sha" != "$ZERO_SHA" ]; then
      if git rev-parse --verify --quiet "$remote_sha^{commit}" >/dev/null; then
	base_sha="$remote_sha"
      else
	tracking_ref=""
	case "$remote_ref" in
	  refs/heads/*) tracking_ref="refs/remotes/$REMOTE_NAME/${remote_ref#refs/heads/}" ;;
	esac

	echo -e "${YELLOW}⚠ Remote tip is unavailable locally; comparing from the closest local base.${NC}"
	base_sha=$(fallback_base_sha "$local_sha" "$tracking_ref" "$REMOTE_NAME/HEAD" "$REMOTE_NAME/main" "$REMOTE_NAME/master") || exit 1
      fi
      RANGES+=("${base_sha}..${local_sha}")
    else
      base_sha=$(fallback_base_sha "$local_sha" "$REMOTE_NAME/HEAD" "$REMOTE_NAME/main" "$REMOTE_NAME/master") || exit 1
      RANGES+=("${base_sha}..${local_sha}")
    fi
done <<< "$PUSH_UPDATES"

# Keep the hook useful when it is run directly from the command line.
if [ "$RECEIVED_UPDATE" = false ]; then
    base_ref="${PRE_PUSH_BASE_REF:-$REMOTE_NAME/main}"
    if git rev-parse --verify --quiet "$base_ref^{commit}" >/dev/null; then
      RANGES+=("${base_ref}..HEAD")
    fi
fi

CHANGED_FILES=()
if ! CHANGED_FILE_OUTPUT=$(
    for range in "${RANGES[@]}"; do
      git diff --name-only --diff-filter=ACMRD "$range" || exit 1
    done | sort -u
); then
    echo -e "${RED}❌ Unable to determine changed files. Fetch the remote branch and try again.${NC}"
    exit 1
fi

while IFS= read -r file; do
    [ -n "$file" ] && CHANGED_FILES+=("$file")
done <<< "$CHANGED_FILE_OUTPUT"

RUBOCOP_FILES=()
if ! RUBOCOP_FILE_OUTPUT=$(printf '%s\n' "${CHANGED_FILES[@]}" | ruby script/hooks/pre_push_file_selector.rb rubocop); then
    echo -e "${RED}❌ Unable to select changed files for Rubocop.${NC}"
    exit 1
fi

while IFS= read -r file; do
    [ -n "$file" ] && RUBOCOP_FILES+=("$file")
done <<< "$RUBOCOP_FILE_OUTPUT"

# 1. Rubocop auto-fix for changed Ruby files
if [ ${#RUBOCOP_FILES[@]} -gt 0 ]; then
    echo -e "${YELLOW}▶ Running Rubocop on ${#RUBOCOP_FILES[@]} changed file(s)...${NC}"
    ./bin/rubocop -a "${RUBOCOP_FILES[@]}"
    if [ $? -ne 0 ]; then
      echo -e "${RED}❌ Rubocop failed. Please fix the issues and try again.${NC}"
      exit 1
    fi
    echo -e "${GREEN}✓ Rubocop passed${NC}"
else
    echo -e "${GREEN}✓ No changed Ruby files to lint${NC}"
fi

# 2. Run tests related to changed source files
RELATED_TESTS=()
if ! RELATED_TEST_OUTPUT=$(printf '%s\n' "${CHANGED_FILES[@]}" | ruby script/hooks/pre_push_file_selector.rb tests); then
    echo -e "${RED}❌ Unable to select related tests.${NC}"
    exit 1
fi

while IFS= read -r file; do
    [ -n "$file" ] && RELATED_TESTS+=("$file")
done <<< "$RELATED_TEST_OUTPUT"

if [ ${#RELATED_TESTS[@]} -gt 0 ]; then
    printf -v TEST_PATHS '%q ' "${RELATED_TESTS[@]}"
    echo -e "${YELLOW}▶ Running ${#RELATED_TESTS[@]} related test file(s)...${NC}"
    RAILS_ENV=test TEST="$TEST_PATHS" rake test
    if [ $? -ne 0 ]; then
      echo -e "${RED}❌ Tests failed. Please fix and try again.${NC}"
      exit 1
    fi
    echo -e "${GREEN}✓ Related tests passed${NC}"
else
    echo -e "${GREEN}✓ No related tests found (the full suite runs in CI)${NC}"
fi

# 3. Check for dead code (unused methods, variables)
echo -e "${YELLOW}▶ Checking for dead code...${NC}"

# Check for binding.pry or debugger statements
if grep -rn "binding\.pry\|binding\.irb\|debugger\|byebug" --include="*.rb" app lib 2>/dev/null; then
    echo -e "${RED}❌ Found debug statements. Please remove them.${NC}"
    exit 1
fi

# Check for puts/p debugging (warn only)
if grep -rn "^\s*puts \|^\s*p \|^\s*pp " --include="*.rb" app lib 2>/dev/null | grep -v "# allowed"; then
    echo -e "${YELLOW}⚠ Found potential debug print statements. Review if intentional.${NC}"
fi

echo -e "${GREEN}✓ No debug statements found${NC}"

# 4. Check for TODO/FIXME (warn only)
echo -e "${YELLOW}▶ Checking for TODO/FIXME...${NC}"
if grep -rn "TODO\|FIXME\|XXX\|HACK" --include="*.rb" app lib 2>/dev/null; then
    echo -e "${YELLOW}⚠ Found TODO/FIXME comments. Consider addressing before push.${NC}"
fi

# 5. Check i18n keys (en and ko must both have all keys)
echo -e "${YELLOW}▶ Checking i18n keys...${NC}"
ruby script/check-i18n.rb
if [ $? -ne 0 ]; then
    echo -e "${RED}❌ i18n check failed. Please add missing translations.${NC}"
    exit 1
fi

# 6. Check for unused files (basic - recently modified but not staged)
echo -e "${YELLOW}▶ Checking for unstaged changes...${NC}"
if ! git diff --quiet; then
    echo -e "${YELLOW}⚠ You have unstaged changes. Consider staging or stashing them.${NC}"
fi

echo ""
echo -e "${GREEN}✓ Pre-push checks completed${NC}"
echo -e "${GREEN}🚀 Ready to push!${NC}"

exit 0
