+    matchDrop(event) {
+      const kind = getKind(event.dataTransfer)
+      if (!kind) return null
+      const match = closest(event, zones, zone => zone.accepts.includes(kind))
+      return match ? { ...match, kind } : null
+    },
+    getDragSource(target) {
+      return closest({ target }, sources)?.el || null
+    },
+    getDropTargets() {
+      const targets = new Set()
+      for (const registry of liveRegistries) {
+        for (const target of registry.localDropTargets()) targets.add(target)
+      }
+      const depth = el => {
+        let value = 0
+        for (let parent = el.parentElement; parent; parent = parent.parentElement) value += 1
+        return value
+      }
+      return [...targets].sort((left, right) => depth(right) - depth(left))
+    },
+    localDropTargets() {
+      const selectors = [...zones].map(zone => zone.selector).join(',')
